# GitHub token used only by local release scripts. Never embed it in either app.
GH_TOKEN=

# Generated by: npm run automation:keygen
ANITRACK_AUTOMATION_PRIVATE_KEY_B64=

# Generated by: npm run android:keygen
ANITRACK_ANDROID_KEYSTORE_FILE=../../.release-secrets/anitrack-next.jks
ANITRACK_ANDROID_KEYSTORE_PASSWORD=
ANITRACK_ANDROID_KEY_ALIAS=anitrack-next
ANITRACK_ANDROID_KEY_PASSWORD=

# Optional Windows Authenticode PFX (file path or base64/data URL supported by electron-builder).
# Until configured, Windows installers build and update successfully but remain unsigned.
CSC_LINK=
CSC_KEY_PASSWORD=

# Optional: your own MAL client ID (register at https://myanimelist.net/apiconfig)
MAL_CLIENT_ID=
